// Prisma-Schema — normalisierte Tabellen (1NF–3NF) aus der UE 2026-10-06.
// Die Zerlegungen aus ../loesung.md sind hier als Prisma-Models modelliert;
// das Schema wird per `prisma migrate dev` erzeugt, nicht per freiem CREATE.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// --- 1NF: atomare Werte (kunde_hobby_denorm -> kunde + hobby) ---

model Kunde {
  kundeId Int     @id @default(autoincrement())
  name    String
  hobbies Hobby[]
}

model Hobby {
  kundeId Int
  hobby   String
  kunde   Kunde @relation(fields: [kundeId], references: [kundeId], onDelete: Cascade)

  @@id([kundeId, hobby])
}

// --- 3NF: transitive Abhaengigkeit (bestellung_denorm -> bestellung + plz) ---

model Plz {
  plz         String      @id
  ort         String
  bestellungen Bestellung[]
  personen    Person[]
}

model Bestellung {
  bestellNr  Int    @id @default(autoincrement())
  kunde      String
  plz        String
  plzRef     Plz    @relation(fields: [plz], references: [plz])
  positionen Bestellposition[]
  produkte   BestellpositionProd[]
}

// --- 1NF: Wiederholgruppe track1/track2/track3 -> bestellposition ---

model Bestellposition {
  bestellNr Int
  position  Int
  trackId   Int
  bestellung Bestellung @relation(fields: [bestellNr], references: [bestellNr], onDelete: Cascade)
  track     Song         @relation(fields: [trackId], references: [songId])

  @@id([bestellNr, position])
}

// --- 2NF: song_playlist_denorm -> song + playlist + song_playlist ---

model Song {
  songId    Int           @id @default(autoincrement())
  titel     String
  dauerSek  Int
  positionen Bestellposition[]
  playlists SongPlaylist[]
}

model Playlist {
  playlistId Int           @id @default(autoincrement())
  name       String
  songs      SongPlaylist[]
}

model SongPlaylist {
  songId     Int
  playlistId Int
  song       Song     @relation(fields: [songId], references: [songId], onDelete: Cascade)
  playlist   Playlist @relation(fields: [playlistId], references: [playlistId], onDelete: Cascade)

  @@id([songId, playlistId])
}

// --- 2NF: bestellposition_prod_denorm -> produkt + bestellposition_prod ---

model Produkt {
  produktNr  Int                  @id @default(autoincrement())
  name        String
  positionen  BestellpositionProd[]
}

model BestellpositionProd {
  bestellNr  Int
  produktNr  Int
  menge       Int
  bestellung  Bestellung @relation(fields: [bestellNr], references: [bestellNr], onDelete: Cascade)
  produkt     Produkt    @relation(fields: [produktNr], references: [produktNr])

  @@id([bestellNr, produktNr])
}

// --- 2NF haelt bereits: die Note braucht beide Schluesselteile ---

model Pruefung {
  matrNr Int
  lvNr   String
  note   Int

  @@id([matrNr, lvNr])
}

// --- SWP-Crossover 3NF: konto_denorm -> konto + blz, person_denorm -> person + plz ---

model Blz {
  blz      String @id
  bankname String
  konten   Konto[]
}

model Konto {
  iban    String @id
  inhaber String
  blz     String
  blzRef  Blz    @relation(fields: [blz], references: [blz])
}

model Person {
  svnr   String @id
  name   String
  plz    String
  plzRef Plz    @relation(fields: [plz], references: [plz])
}
